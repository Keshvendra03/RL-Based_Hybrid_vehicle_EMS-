__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
*.egg-info/

# train_sac.py run outputs: checkpoints, TensorBoard logs, eval CSVs.
# These are experiment artifacts, not source -- run_config.json inside
# each already records the exact CLI args + git commit needed to
# reproduce them, so the artifacts themselves don't belong in git.
models/
models_*/
saved_models/
logs/

# Large experiment artifacts (reproducible from the frozen configs stored
# next to them): SB3 replay buffers and model checkpoints under results/.
results/**/*.pkl
results/**/*.zip

# Per-user IDE session state (project config in .idea/ stays tracked).
.idea/workspace.xml
